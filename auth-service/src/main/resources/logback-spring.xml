<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <springProperty scope="context" name="serviceName" source="spring.application.name" defaultValue="unknown-service"/>
    <property name="environment" value="${SPRING_PROFILES_ACTIVE:-default}"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>{"timestamp":"%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX}","service":"${serviceName}","env":"${environment}","trace_id":"%X{trace_id:-}","span_id":"%X{span_id:-}","customer_id":"%X{customer_id:-}","payment_id":"%X{payment_id:-}","error_code":"%X{error_code:-}","severity":"%level","message":"%msg"}%n</pattern>
        </encoder>
    </appender>

    <appender name="OTEL" class="io.opentelemetry.instrumentation.logback.appender.v1_0.OpenTelemetryAppender"/>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="OTEL"/>
    </root>
</configuration>
