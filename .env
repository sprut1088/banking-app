# Copy to .env.local and provide your local secret value.
SPLUNK_HEC_TOKEN=7931493c-b2d9-47d8-b460-d95915a9741d
# Splunk Web is commonly on :8000, but HEC ingestion is typically on :8088/services/collector.
SPLUNK_HEC_ENDPOINT=http://10.235.21.132:8088/services/collector
SPLUNK_INDEX=banking

OPENSEARCH_ENDPOINT=http://10.235.21.132:9200
OPENSEARCH_LOGS_INDEX=banking

# Prometheus remote write endpoint (requires remote-write receiver enabled on target Prometheus).
PROMETHEUS_REMOTE_WRITE_ENDPOINT=http://10.235.21.132:9090/api/v1/write

# Jaeger traces ingest endpoint. If your gateway/proxy exposes Jaeger under /jaeger, keep this path.
JAEGER_TRACES_ENDPOINT=http://10.235.21.132:8080/jaeger/api/traces
